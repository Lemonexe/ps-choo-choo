{
  "name": "ps-choo-choo",
  "version": "1.0.0",
  "private": true,
  "description": "Steam locomotive simulator with a thermodynamic engine.",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "build": "tsc",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.physics.json",
    "watch": "tsc --watch",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm run typecheck && npm run build && node --test --test-isolation=none tests/*.test.mjs",
    "test:convergence": "npm run build && node scripts/convergence.mjs",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "test:browser:static": "npm run build:vercel && node scripts/browser-test.mjs --static"
  },
  "dependencies": {
    "iapws-if97": "2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11"
  }
}
