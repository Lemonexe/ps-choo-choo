{
  "name": "ps-choo-choo",
  "version": "1.0.0",
  "description": "Steam locomotive simulator with a thermodynamic engine.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:convergence": "npm run build && node scripts/convergence.mjs",
    "test:browser": "npm run build && node scripts/browser-test.mjs"
  }
}
